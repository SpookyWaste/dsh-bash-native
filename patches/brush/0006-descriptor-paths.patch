+/// A path that names one of the calling process's own descriptors rather than a file.
+///
+/// Opening such a path for real reaches the *process's* descriptor table, and a shell embedded in a
+/// larger host shares that process, so `/dev/stdout` would be the host's stdout rather than the
+/// command's. Callers resolve these paths against the shell's descriptors instead. Ported from
+/// oh-my-pi's vendored copy of this crate, which added the grammar this project needed on Windows,
+/// where these paths are otherwise read as `<drive>:\dev\...`.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum DescriptorPath {
+    /// `/dev/stdin`, `/dev/stdout`, `/dev/stderr`, or `N` under `/dev/fd`, `/proc/self/fd`,
+    /// `/proc/thread-self/fd`, or `/proc/<this pid>/fd`.
+    Fd(ShellFd),
+    /// `/dev/tty`, which names a controlling terminal this platform does not have.
+    Terminal,
+}
+
+impl DescriptorPath {
+    /// Classifies an absolute path; `None` for every other path, including relative paths and the
+    /// descriptor directories themselves.
+    ///
+    /// A Windows drive or UNC prefix is skipped first, so both the spelling a script uses
+    /// (`/dev/stdout`) and the one `Shell::absolute_path` produces (`D:\dev\stdout`) are recognized.
+    /// That is deliberate: redirection targets reach `Shell::open_file` from more than one call site,
+    /// and one of them makes the path absolute before opening it.
+    pub fn parse(path: &std::path::Path) -> Option<Self> {
+        use std::path::Component;
+
+        let mut components = path.components().peekable();
+        if matches!(components.peek(), Some(Component::Prefix(_))) {
+            // A drive letter or UNC host carries no meaning for a descriptor path.
+            components.next();
+        }
+        if components.next() != Some(Component::RootDir) {
+            return None;
+        }
+
+        let mut names = [""; 4];
+        let mut len = 0;
+        for component in components {
+            let Component::Normal(name) = component else {
+                return None;
+            };
+            *names.get_mut(len)? = name.to_str()?;
+            len += 1;
+        }
+
+        match names[..len] {
+            ["dev", "stdin"] => Some(Self::Fd(OpenFiles::STDIN_FD)),
+            ["dev", "stdout"] => Some(Self::Fd(OpenFiles::STDOUT_FD)),
+            ["dev", "stderr"] => Some(Self::Fd(OpenFiles::STDERR_FD)),
+            ["dev", "tty"] => Some(Self::Terminal),
+            ["dev", "fd", fd] | ["proc", "self" | "thread-self", "fd", fd] => decimal(fd).map(Self::Fd),
+            ["proc", pid, "fd", fd] if decimal::<u32>(pid) == Some(std::process::id()) => {
+                decimal(fd).map(Self::Fd)
+            }
+            _ => None,
+        }
+    }
+}
+
+/// Parses an unsigned decimal path component, as the kernel spells descriptor numbers and pids; signs
+/// and other text are not numbers here.
+fn decimal<T: std::str::FromStr>(name: &str) -> Option<T> {
+    if name.is_empty() || !name.bytes().all(|byte| byte.is_ascii_digit()) {
+        return None;
+    }
+    name.parse().ok()
+}
+
+#[cfg(test)]
+mod descriptor_path_tests {
+    use super::DescriptorPath::{self, Fd, Terminal};
+    use super::OpenFiles;
+    use std::path::Path;
+
+    fn parse(path: &str) -> Option<DescriptorPath> {
+        DescriptorPath::parse(Path::new(path))
+    }
+
+    #[test]
+    fn standard_streams_and_descriptor_directories_are_recognized() {
+        assert_eq!(parse("/dev/stdin"), Some(Fd(OpenFiles::STDIN_FD)));
+        assert_eq!(parse("/dev/stdout"), Some(Fd(OpenFiles::STDOUT_FD)));
+        assert_eq!(parse("/dev/stderr"), Some(Fd(OpenFiles::STDERR_FD)));
+        assert_eq!(parse("/dev/fd/63"), Some(Fd(63)));
+        assert_eq!(parse("/proc/self/fd/3"), Some(Fd(3)));
+        assert_eq!(parse("/proc/thread-self/fd/3"), Some(Fd(3)));
+        assert_eq!(parse("/dev/tty"), Some(Terminal));
+    }
+
+    #[test]
+    fn others_are_left_to_the_filesystem() {
+        assert_eq!(parse("/dev/null"), None, "the platform-specific open handles the null device");
+        assert_eq!(parse("/dev/fd"), None, "the directory itself is not a descriptor");
+        assert_eq!(parse("/dev/fd/nope"), None);
+        assert_eq!(parse("dev/stdout"), None, "relative paths are not descriptor paths");
+        assert_eq!(parse("/dev/stdout/extra"), None);
+        assert_eq!(parse(&std::format!("/proc/{}/fd/1", std::process::id() + 1)), None, "another process");
+    }
+
+    #[test]
+    #[cfg(windows)]
+    fn an_absolute_windows_spelling_is_recognized_too() {
+        // Shell::absolute_path turns /dev/stdout into the drive-rooted spelling; a call site that
+        // absolutizes before opening must still land on the shell's descriptor.
+        assert_eq!(parse(r"D:\dev\stdout"), Some(Fd(OpenFiles::STDOUT_FD)));
+        assert_eq!(parse(r"C:\dev\fd\5"), Some(Fd(5)));
+    }
+}
