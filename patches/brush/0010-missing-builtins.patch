@@ -0,0 +1,85 @@
+use clap::Parser;
+use std::io::Write;
+
+use brush_core::{ExecutionResult, builtins, jobs::JobState};
+
+/// Remove jobs from the shell's job table.
+#[derive(Parser)]
+pub(crate) struct DisownCommand {
+    /// Remove every job.
+    #[arg(short = 'a')]
+    all: bool,
+
+    /// Remove only the jobs that are still running.
+    #[arg(short = 'r')]
+    running_only: bool,
+
+    /// Mark the jobs so no SIGHUP is sent when the shell exits, keeping them in the table.
+    #[arg(short = 'h')]
+    no_hangup: bool,
+
+    /// Job specs (`%1`, `%%`, `%-`) or process IDs; the current job when none is given.
+    ids: Vec<String>,
+}
+
+impl builtins::Command for DisownCommand {
+    type Error = brush_core::Error;
+
+    async fn execute<SE: brush_core::ShellExtensions>(
+        &self,
+        context: brush_core::ExecutionContext<'_, SE>,
+    ) -> Result<ExecutionResult, Self::Error> {
+        // `-h` only changes what the shell does when it exits, and this shell never sends a job a SIGHUP:
+        // the command it started outlives the shell (children are not killed on drop) and the harness
+        // ends the process tree when the call ends. Accepting the flag without removing anything is what
+        // it means here.
+        if self.no_hangup {
+            return Ok(ExecutionResult::success());
+        }
+
+        let manager = context.shell.jobs_mut();
+        let indices: Vec<usize> = if self.all {
+            (0..manager.jobs.len()).collect()
+        } else if self.ids.is_empty() {
+            // Bash's default target is the current job, and there is nothing to do when there is none.
+            manager
+                .current_job()
+                .and_then(|current| manager.jobs.iter().position(|job| job.id == current.id))
+                .into_iter()
+                .collect()
+        } else {
+            let mut indices = Vec::new();
+            for spec in &self.ids {
+                let id = if spec.starts_with('%') {
+                    manager.resolve_job_spec(spec).map(|job| job.id)
+                } else {
+                    brush_core::int_utils::parse::<i32>(spec.as_str(), 10)
+                        .ok()
+                        .and_then(|pid| manager.resolve_process_id(pid).map(|job| job.id))
+                };
+                match id.and_then(|id| manager.jobs.iter().position(|job| job.id == id)) {
+                    Some(index) => indices.push(index),
+                    None => {
+                        writeln!(context.stderr(), "{}: {}: no such job", context.command_name, spec)?;
+                        return Ok(ExecutionResult::general_error());
+                    }
+                }
+            }
+            indices
+        };
+
+        // Remove from the end so earlier indices stay valid. A disowned job keeps running: dropping the
+        // shell's handle to a child does not terminate it (`kill_external_commands_on_drop` is false for
+        // an ordinary shell), which is the same thing bash leaves behind.
+        let mut removable: Vec<usize> = indices
+            .into_iter()
+            .filter(|index| !self.running_only || matches!(manager.jobs[*index].state, JobState::Running))
+            .collect();
+        removable.sort_unstable();
+        for index in removable.into_iter().rev() {
+            manager.jobs.remove(index);
+        }
+
+        Ok(ExecutionResult::success())
+    }
+}
