+/// Refuses operands whose trailing separator says "directory" but which name something else.
+///
+/// POSIX gives this rule to the kernel: `unlink("file/")` fails with `ENOTDIR`, and `rm` reports it. Windows
+/// has no such failure — whether a volume rejects a trailing separator on a regular file turns out to be a
+/// property of the volume, and on one of them `rm -r file/` deletes the file. The engine therefore applies
+/// the rule itself, so one command behaves the same way on every volume, with GNU's wording.
+///
+/// A refused operand is dropped from `args` so the rest of the command still runs, which is what GNU does;
+/// the caller turns a refusal into exit status 1 even when the remaining operands succeeded.
+/// @returns whether anything was refused, and how many operands survive.
+fn refuse_trailing_separator_on_a_regular_file(args: &mut Vec<OsString>) -> (bool, usize) {
+    let mut options = true;
+    let mut refused = false;
+    let mut surviving = 0;
+    let mut kept: Vec<OsString> = Vec::with_capacity(args.len());
+    for (index, argument) in std::mem::take(args).into_iter().enumerate() {
+        if index == 0 {
+            kept.push(argument);
+            continue;
+        }
+        let text = argument.to_string_lossy().into_owned();
+        if options && text == "--" {
+            options = false;
+            kept.push(argument);
+            continue;
+        }
+        if options && text.len() > 1 && text.starts_with('-') {
+            kept.push(argument);
+            continue;
+        }
+        let separator = text.ends_with('/') || (cfg!(windows) && text.ends_with('\\'));
+        if separator && !std::path::Path::new(&argument).is_dir() {
+            eprintln!("rm: cannot remove '{text}': Not a directory");
+            refused = true;
+            continue;
+        }
+        surviving += 1;
+        kept.push(argument);
+    }
+    *args = kept;
+    (refused, surviving)
+}
+
+/// `rm`, with the rule the platform does not apply: a trailing separator means a directory.
+#[cfg(feature = "coreutils.rm")]
+fn rm_with_platform_rule(args: Vec<OsString>) -> i32 {
+    let mut remaining = args;
+    let (refused, surviving) = refuse_trailing_separator_on_a_regular_file(&mut remaining);
+    // With no operand left there is nothing to remove, and calling the utility would add a second complaint
+    // ("missing operand") that GNU does not print for a refused operand.
+    let code = if refused && surviving == 0 {
+        1
+    } else {
+        prepare_uutil_runtime("uu_rm");
+        let code = uu_rm::uumain(remaining.into_iter());
+        finalize_uutil_runtime();
+        code
+    };
+    if refused { code.max(1) } else { code }
+}
