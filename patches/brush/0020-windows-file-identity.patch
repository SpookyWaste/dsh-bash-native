diff --git a/brush-core/src/sys/windows/fs.rs b/brush-core/src/sys/windows/fs.rs
index ec5d27a..d744872 100644
--- a/brush-core/src/sys/windows/fs.rs
+++ b/brush-core/src/sys/windows/fs.rs
@@ -125,8 +125,41 @@ impl crate::sys::fs::PathExt for Path {
     }
 
     fn get_device_and_inode(&self) -> Result<(u64, u64), crate::error::Error> {
-        // TODO(windows): implement using file index / volume serial number.
-        Err(error::ErrorKind::NotSupportedOnThisPlatform("get_device_and_inode").into())
+        use std::os::windows::fs::OpenOptionsExt as _;
+        use std::os::windows::io::AsRawHandle as _;
+        use windows_sys::Win32::Storage::FileSystem::{
+            BY_HANDLE_FILE_INFORMATION, FILE_FLAG_BACKUP_SEMANTICS, GetFileInformationByHandle,
+        };
+
+        // No access rights are requested, which is all this needs: a file the caller may not read can
+        // still be identified, and a directory can be opened this way. `FILE_FLAG_BACKUP_SEMANTICS` is
+        // what lets the handle name a directory at all, and `FILE_FLAG_OPEN_REPARSE_POINT` is
+        // deliberately absent: `-ef` is `stat` on Unix, which follows a symlink, so this follows one too.
+        let file = std::fs::OpenOptions::new()
+            .access_mode(0)
+            .custom_flags(FILE_FLAG_BACKUP_SEMANTICS)
+            .open(self)?;
+
+        // SAFETY: `BY_HANDLE_FILE_INFORMATION` is a `#[repr(C)]` record of integers, for which an
+        // all-zero value is valid; the call below is what fills it in.
+        let mut info: BY_HANDLE_FILE_INFORMATION = unsafe { std::mem::zeroed() };
+        // SAFETY: the handle is live for the duration of the call and `info` is a correctly sized
+        // out-parameter for it.
+        let succeeded = unsafe { GetFileInformationByHandle(file.as_raw_handle(), &mut info) };
+        if succeeded == 0 {
+            return Err(std::io::Error::last_os_error().into());
+        }
+
+        // A zero file index means the volume could not supply an identity, and zero is not one: two
+        // files that both answered `(volume, 0)` would compare equal, turning "this cannot be answered"
+        // into a wrong answer. The file index is 64 bits wide and NTFS fills it; a filesystem that does
+        // not gets the loud refusal `-ef` had before instead of a silent `true`.
+        if info.nFileIndexHigh == 0 && info.nFileIndexLow == 0 {
+            return Err(error::ErrorKind::NotSupportedOnThisPlatform("get_device_and_inode").into());
+        }
+
+        let inode = (u64::from(info.nFileIndexHigh) << 32) | u64::from(info.nFileIndexLow);
+        Ok((u64::from(info.dwVolumeSerialNumber), inode))
     }
 }
 
