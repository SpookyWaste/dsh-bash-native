+/// Waits for one managed job and returns the result it finished with.
+///
+/// The poll comes first on purpose: a job whose process has already exited may still hold a result that
+/// nobody has collected, and waiting for its tasks alone would report success no matter how it ended.
+///
+/// # Arguments
+///
+/// * `job` - The job to wait for.
+async fn wait_for_job(job: &mut Job) -> Result<ExecutionResult, brush_core::Error> {
+    if let Some(result) = job.poll_done()? {
+        return result;
+    }
+
+    job.wait().await
+}
