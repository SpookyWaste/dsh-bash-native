+        // uucore reports a value it cannot convert by setting a process-wide exit code and writing the
+        // message itself rather than returning an error, so that code is the only signal the conversion
+        // failed and nothing else in the shell reads it. A code left behind by an earlier command would
+        // be read as this command's, so it is captured here and put back on the way out.
+        let previous_exit_code = uucore::error::get_exit_code();
+        uucore::error::set_exit_code(0);
+
+        let outcome = self.run(context).await;
+        let conversion_exit_code = uucore::error::get_exit_code();
+        uucore::error::set_exit_code(previous_exit_code);
+
+        outcome?;
+
+        if conversion_exit_code == 0 {
+            Ok(ExecutionResult::success())
+        } else {
+            // A refused conversion fails the command even though the format ran on with the value uucore
+            // defaulted, which is the status GNU printf reports for the same input.
+            Ok(ExecutionResult::new(
+                u8::try_from(conversion_exit_code).unwrap_or(1),
+            ))
+        }
+    }
+}
