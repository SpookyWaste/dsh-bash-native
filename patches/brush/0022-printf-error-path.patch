+/// A sentence describing a format error, in the wording uucore's own error catalogue carries.
+///
+/// `FormatError`'s own message is resolved through the Fluent bundle uucore embeds for the utility being
+/// run, and this command is a builtin of the engine rather than a bundled utility, so that lookup misses
+/// and the raw message id is what would reach the user. The text below is that catalogue's `en-US`
+/// wording, which is also what the toolchain's `printf` prints for the same input.
+fn describe_format_error(error: &format::FormatError) -> String {
+    match error {
+        format::FormatError::SpecError(spec, _) => format!(
+            "%{}: invalid conversion specification",
+            String::from_utf8_lossy(spec)
+        ),
+        format::FormatError::TooManySpecs(text) => format!(
+            "format '{}' has too many % directives",
+            String::from_utf8_lossy(text)
+        ),
+        format::FormatError::NeedAtLeastOneSpec(text) => format!(
+            "format '{}' has no % directive",
+            String::from_utf8_lossy(text)
+        ),
+        format::FormatError::EndsWithPercent(text) => {
+            format!("format {} ends in %", String::from_utf8_lossy(text))
+        }
+        format::FormatError::InvalidPrecision(precision) => {
+            format!("invalid precision: '{precision}'")
+        }
+        format::FormatError::WrongSpecType => "wrong % directive type was given".to_string(),
+        format::FormatError::NoMoreArguments => "no more arguments".to_string(),
+        format::FormatError::InvalidArgument(_) => "invalid argument".to_string(),
+        format::FormatError::MissingHex(_) => "missing hexadecimal number in escape".to_string(),
+        format::FormatError::InvalidCharacter(escape, digits, _) => format!(
+            "invalid universal character name \\{escape}{}",
+            String::from_utf8_lossy(digits)
+        ),
+        // These two describe themselves: the I/O variant is turned into an `Error` of its own before this
+        // is reached, and the encoding variant's message is not a catalogue entry.
+        format::FormatError::IoError(error) => error.to_string(),
+        format::FormatError::InvalidEncoding(error) => error.to_string(),
+    }
 }
 
