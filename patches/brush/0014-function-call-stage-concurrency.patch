+    /// Run a shell function for a pipeline stage that owns its shell, on a blocking thread.
+    ///
+    /// The same reason as [`Self::execute_via_builtin_in_owned_shell`]: a function body runs in this
+    /// process, so awaiting it in the pipeline's spawn loop would finish the stage before the stages after
+    /// it had been started, and a stage that writes more than the pipe buffer would block forever with
+    /// nobody reading it (`f() { cat big; }; f | head -1`). The body's own spawn result is awaited here,
+    /// because a function may end in an external command and the pipeline waits on one handle per stage.
+    fn execute_via_function_in_owned_shell(
+        mut shell: Shell<SE>,
+        params: ExecutionParameters,
+        func_registration: functions::Registration,
+        command_name: String,
+        args: Vec<CommandArg>,
+    ) -> ExecutionSpawnResult {
+        let last_arg = Self::take_last_arg(&args);
+        let join_handle = tokio::task::spawn_blocking(move || {
+            let cmd_context = ExecutionContext {
+                shell: &mut shell,
+                command_name,
+                params,
+            };
+
+            let rt = tokio::runtime::Handle::current();
+            let result = rt.block_on(async {
+                match invoke_shell_function(func_registration, cmd_context, &args[1..]).await? {
+                    ExecutionSpawnResult::Completed(result) => Ok(result),
+                    // A stopped child cannot be reported through this handle, and job control is off in
+                    // a pipeline stage's own shell, so the stage reports its own status instead.
+                    other => match other.wait().await? {
+                        ExecutionWaitResult::Completed(result) => Ok(result),
+                        ExecutionWaitResult::Stopped(_) => Ok(ExecutionResult::stopped()),
+                    },
+                }
+            });
+
+            // $_ is reset after the function body runs; see `execute_via_function`.
+            shell.update_last_arg_variable(last_arg);
+
+            result
+        });
+
+        ExecutionSpawnResult::StartedTask(join_handle)
+    }
