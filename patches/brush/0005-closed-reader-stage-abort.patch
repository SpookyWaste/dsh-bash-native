+    /// produces for a `SIGPIPE` death (141). A compound command has to treat it as fatal for the
+    /// stage: bash runs a pipeline stage in a child process that dies, while this shell can run the
+    /// stage in-process, and a loop that keeps writing into a closed pipe would otherwise never end.
+    #[must_use]
+    pub const fn is_broken_pipe(&self) -> bool {
+        matches!(self.exit_code, ExecutionExitCode::BrokenPipe)
+    }
