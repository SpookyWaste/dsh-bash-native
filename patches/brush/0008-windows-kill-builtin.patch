+/// Opens a process for the given access, mapping a failure the way a shell reports one.
+///
+/// # Arguments
+/// * `pid` - The process ID to open.
+/// * `access` - The access rights to request.
+#[cfg(windows)]
+fn open_process(
+    pid: sys::process::ProcessId,
+    access: u32,
+) -> Result<windows_sys::Win32::Foundation::HANDLE, error::Error> {
+    use windows_sys::Win32::Foundation::{ERROR_INVALID_PARAMETER, GetLastError};
+    use windows_sys::Win32::System::Threading::OpenProcess;
+
+    let Ok(pid) = u32::try_from(pid) else {
+        return Err(error::ErrorKind::NoSuchProcess.into());
+    };
+
+    // SAFETY: OpenProcess is called with a numeric process ID and no handle inheritance; a null result is
+    // checked below, and the handle is owned by the caller once returned.
+    let handle = unsafe { OpenProcess(access, 0, pid) };
+    if handle.is_null() {
+        // Windows reports a process ID that does not exist as an invalid parameter; anything else means
+        // the process exists but is not ours to touch, which is the mapping the unix implementation uses.
+        let last_error = unsafe { GetLastError() };
+
+        return Err(if last_error == ERROR_INVALID_PARAMETER {
+            error::ErrorKind::NoSuchProcess.into()
+        } else {
+            error::ErrorKind::PermissionDenied.into()
+        });
+    }
+
+    Ok(handle)
+}
+
+/// Ends a process with the given exit status.
+///
+/// # Arguments
+/// * `pid` - The process ID to terminate.
+/// * `exit_code` - The status the process reports when it ends.
+#[cfg(windows)]
+fn terminate_process(pid: sys::process::ProcessId, exit_code: u32) -> Result<(), error::Error> {
+    use windows_sys::Win32::Foundation::CloseHandle;
+    use windows_sys::Win32::System::Threading::{PROCESS_TERMINATE, TerminateProcess};
+
+    let handle = open_process(pid, PROCESS_TERMINATE)?;
+
+    // SAFETY: the handle came from OpenProcess with PROCESS_TERMINATE, which is what the call requires.
+    let terminated = unsafe { TerminateProcess(handle, exit_code) };
+    // SAFETY: the handle is closed exactly once here.
+    let _closed = unsafe { CloseHandle(handle) };
+
+    if terminated == 0 {
+        return Err(error::ErrorKind::FailedToSendSignal.into());
+    }
+
+    Ok(())
+}
