+/// The signal vocabulary Windows can name, where no signal is ever delivered to a process.
+///
+/// `TerminateProcess` is the only way to end a process on Windows, so every one of these is a request to
+/// end the target rather than a message it can handle. The numbers are the ones bash and MSYS use, and a
+/// killed process reports `128 + number`, which is exactly what Git Bash reports for a native Windows
+/// child (measured: `INT` 130, `KILL` 137, `TERM` 143, `HUP` 129). The names are here because scripts and
+/// `kill -l` read them, and because a named signal has to parse before it can be acted on.
+#[cfg(windows)]
+#[allow(unnameable_types)]
+#[derive(Clone, Copy, Debug, Eq, Hash, PartialEq)]
+#[repr(i32)]
+pub enum Signal {
+    /// Hangup.
+    Hangup = 1,
+    /// Interrupt.
+    Interrupt = 2,
+    /// Quit.
+    Quit = 3,
+    /// Illegal instruction.
+    Ill = 4,
+    /// Trace trap.
+    Trap = 5,
+    /// Abort.
+    Abort = 6,
+    /// Bus error.
+    Bus = 7,
+    /// Floating-point exception.
+    Fpe = 8,
+    /// Kill.
+    Kill = 9,
+    /// User-defined signal 1.
+    Usr1 = 10,
+    /// Segmentation violation.
+    Segv = 11,
+    /// User-defined signal 2.
+    Usr2 = 12,
+    /// Broken pipe.
+    Pipe = 13,
+    /// Alarm clock.
+    Alarm = 14,
+    /// Terminate.
+    Terminate = 15,
+    /// Stack fault.
+    StackFault = 16,
+    /// Child status changed.
+    Child = 17,
+    /// Continue.
+    Continue = 18,
+    /// Stop.
+    Stop = 19,
+    /// Terminal stop.
+    TerminalStop = 20,
+    /// Terminal input.
+    TerminalInput = 21,
+    /// Terminal output.
+    TerminalOutput = 22,
+    /// Urgent socket condition.
+    Urgent = 23,
+    /// CPU time limit exceeded.
+    CpuLimit = 24,
+    /// File size limit exceeded.
+    FileSizeLimit = 25,
+    /// Virtual timer expired.
+    VirtualAlarm = 26,
+    /// Profiling timer expired.
+    ProfilingAlarm = 27,
+    /// Window size change.
+    WindowChange = 28,
+    /// I/O now possible.
+    Io = 29,
+    /// Power failure.
+    Power = 30,
+    /// Bad system call.
+    SystemCall = 31,
+}
