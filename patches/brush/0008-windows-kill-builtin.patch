+
+    /// Creates a `Signal` from a string representation, with or without a `SIG` prefix and in any case.
+    pub fn from_str(s: &str) -> Result<Self, error::Error> {
+        let uppercase = s.to_ascii_uppercase();
+        let short_name = uppercase.strip_prefix("SIG").unwrap_or(uppercase.as_str());
+
+        Self::iterator()
+            .find(|signal| signal.as_str().strip_prefix("SIG") == Some(short_name))
+            .ok_or_else(|| error::ErrorKind::InvalidSignal(s.into()).into())
+    }
+}
+
+#[cfg(windows)]
+impl TryFrom<i32> for Signal {
+    type Error = error::Error;
+
+    fn try_from(value: i32) -> Result<Self, Self::Error> {
+        Self::iterator()
+            .find(|signal| *signal as i32 == value)
+            .ok_or_else(|| error::ErrorKind::InvalidSignal(std::format!("{value}")).into())
+    }
+}
