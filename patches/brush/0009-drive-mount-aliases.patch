+/// The Windows root one `/<letter>` mount stands for, or `None` when the component is not a single
+/// ASCII letter.
+///
+/// Pattern expansion builds its own root instead of going through [`normalize_shell_path`], so it asks
+/// this function for the same rule rather than repeating it.
+#[cfg(any(windows, test))]
+#[must_use]
+pub fn drive_mount_root(component: &str) -> Option<PathBuf> {
+    let mut characters = component.chars();
+    let first = characters.next()?;
+    if !first.is_ascii_alphabetic() || characters.next().is_some() {
+        return None;
+    }
+    Some(PathBuf::from(format!("{}:\\", first.to_ascii_uppercase())))
+}
+
+/// Like [`translate_drive_mount_path`], but refuses the bare mount root.
+///
+/// A bare `/<letter>` argument is how Windows' own tools spell their switches — `cmd.exe /c` is the
+/// common one — so an argument that is exactly a mount root is left alone. The shell's own path
+/// resolution has no such ambiguity (`cd /c` is always the drive root), and an option's attached value
+/// is unambiguous too, so both still accept it. Git Bash converts the bare form as well, which is why
+/// its users have to reach for `MSYS_NO_PATHCONV` before calling `cmd.exe /c`; this engine does not
+/// copy that footgun.
+#[cfg(any(windows, test))]
+fn translate_drive_mount_argument(path: &Path) -> Option<PathBuf> {
+    let mounted = translate_drive_mount_path(path)?;
+    // RootDir plus the letter is the whole path; a trailing separator adds no component.
+    if path.components().count() <= 2 {
+        return None;
+    }
+    Some(mounted)
+}
