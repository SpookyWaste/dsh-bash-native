+/// Spawn a background pipeline directly and register its children as external job tasks.
+///
+/// Without this, every `cmd &` becomes an in-process tokio task, `Job::representative_pid()` finds no
+/// external task, and `$!` expands to the empty string — so the idiomatic `cmd & p=$!; kill $p`
+/// silently loses its target. Returns `None` when nothing directly spawnable was produced, leaving the
+/// caller to use the in-process path exactly as before.
+async fn try_spawn_pipeline_as_job<SE: extensions::ShellExtensions>(
+    ao_list: &ast::AndOrList,
+    shell: &mut Shell<SE>,
+    params: &ExecutionParameters,
+) -> Result<Option<jobs::Job>, error::Error> {
+    let Some(pipeline) = directly_spawnable_pipeline(ao_list, shell) else {
+        return Ok(None);
+    };
+
+    // Match the in-process path's environment: a background job is not interactive and reads from
+    // null, so it can neither touch the terminal nor steal the parent's stdin.
+    let mut cloned_shell = shell.clone();
+    let mut cloned_params = params.clone();
+    cloned_shell.options_mut().interactive = false;
+    if let Ok(null) = openfiles::null() {
+        cloned_params.set_fd(openfiles::OpenFiles::STDIN_FD, null);
+    }
+
+    let spawn_results = spawn_pipeline_processes(pipeline, &mut cloned_shell, &cloned_params).await?;
+    let mut tasks = VecDeque::new();
+    for spawn_result in spawn_results {
+        if let ExecutionSpawnResult::StartedProcess(child) = spawn_result {
+            tasks.push_back(jobs::JobTask::External(child));
+        } else {
+            // An internal task or an already-finished command cannot report a PID, and a job that is
+            // only half external would make `$!` report a partial answer.
+            return Ok(None);
+        }
+    }
+    if tasks.is_empty() {
+        return Ok(None);
+    }
+    Ok(Some(jobs::Job::new(
+        tasks,
+        ao_list.to_string(),
+        jobs::JobState::Running,
+    )))
+}
