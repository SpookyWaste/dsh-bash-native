+/// Whether a background and-or list is a single pipeline of literal, external simple commands.
+///
+/// Only such a pipeline can be spawned directly, and spawning directly is what gives the job a real
+/// child process — which is what `$!` and `jobs -p` read. The decision has to be made *before*
+/// anything is spawned: a builtin or a function has no child process, and discovering that afterwards
+/// would mean abandoning processes that had already started. A command name that is not a plain
+/// literal is declined rather than resolved, because resolving it needs expansion and expansion can
+/// run command substitution.
+fn directly_spawnable_pipeline<'a, SE: extensions::ShellExtensions>(
+    ao_list: &'a ast::AndOrList,
+    shell: &Shell<SE>,
+) -> Option<&'a ast::Pipeline> {
+    if !ao_list.additional.is_empty() {
+        return None;
+    }
+    let pipeline = &ao_list.first;
+    if pipeline.bang || pipeline.seq.is_empty() {
+        return None;
+    }
+    for command in &pipeline.seq {
+        let ast::Command::Simple(simple) = command else {
+            return None;
+        };
+        let Some(word) = &simple.word_or_name else {
+            return None;
+        };
+        let name = word.flatten();
+        if name.is_empty()
+            || shell.builtins().get(&name).is_some()
+            || shell.funcs().get(name.as_str()).is_some()
+        {
+            return None;
+        }
+    }
+    Some(pipeline)
+}
