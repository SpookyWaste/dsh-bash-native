+#[cfg(test)]
+mod expand_to_long_path_tests {
+    use super::expand_to_long_path;
+    use std::path::{Path, PathBuf};
+
+    #[test]
+    fn a_path_that_is_not_there_is_returned_unchanged() {
+        // The Win32 query has no answer for a name that does not exist, and the call sites keep the
+        // behaviour they had before: the path is used exactly as it was given.
+        let missing = PathBuf::from(r"C:\dsh-bash-native-does-not-exist\EXAMPL~1\tail");
+        assert_eq!(expand_to_long_path(&missing), missing);
+        assert_eq!(expand_to_long_path(Path::new(r"D:\dsh-bash-native-does-not-exist")), PathBuf::from(r"D:\dsh-bash-native-does-not-exist"));
+    }
+
+    #[test]
+    fn a_relative_path_is_returned_unchanged() {
+        // Resolving it against the current directory would turn a relative path into an absolute one,
+        // which is a different answer to a different question.
+        let relative = Path::new(r"EXAMPL~1\tail");
+        assert_eq!(expand_to_long_path(relative), relative);
+    }
+
+    #[test]
+    fn expanding_twice_changes_nothing_further() {
+        // The process's temporary directory always exists, and a long name has no 8.3 component left in
+        // it, so the second call has to reproduce the first.
+        let once = expand_to_long_path(&std::env::temp_dir());
+        assert!(once.is_absolute(), "the temporary directory is absolute");
+        assert_eq!(expand_to_long_path(&once), once);
+    }
+}
