+/// Expands a path that names an existing file or directory into its long form.
+///
+/// Windows keeps a second, 8.3 name for most directories, and both spellings name the same place:
+/// `C:\Users\EXAMPL~1\AppData\Local\Temp` and `C:\Users\Example\AppData\Local\Temp` are one
+/// directory. The short spelling arrives from the host — `%TEMP%` and the directory the process was
+/// started in are whatever Windows reports — while a script that writes the same path out in full
+/// produces the long one. Measured here: `cd /tmp` and `cd "C:/Users/Example/AppData/Local/Temp"`
+/// landed on the same directory and left two different `$PWD` values, so a comparison between them was
+/// false for one location.
+///
+/// `GetLongPathNameW` answers only for a path that exists. Anything else — a name that is not there, a
+/// volume with 8.3 names disabled, a query that fails — comes back unchanged, which is what every call
+/// site did before this existed.
+///
+/// This is deliberately not `canonicalize`: that resolves symlinks and junctions and prefixes the
+/// result with `\\?\`, and a `cd` into a symlinked directory has to keep the spelling the script used.
+#[must_use]
+pub fn expand_to_long_path(path: &Path) -> PathBuf {
+    #[cfg(windows)]
+    {
+        // A relative path is left alone rather than resolved against the current directory: the Win32
+        // query would answer with an absolute path, and turning one into the other is not what a caller
+        // asking for a spelling is asking for.
+        if path.is_absolute()
+            && let Some(expanded) = expand_to_long_path_win32(path)
+        {
+            return expanded;
+        }
+    }
+    path.to_path_buf()
+}
+
+/// [`expand_to_long_path`] applied to the process's temporary directory.
+///
+/// `/tmp` resolves through this, and the shell's `$TEMP` is normalized to the same spelling (see
+/// `sys::windows::env`), so the two names a script is most likely to compare agree.
+#[cfg(windows)]
+#[must_use]
+pub fn long_temp_dir() -> PathBuf {
+    expand_to_long_path(&std::env::temp_dir())
+}
+
+/// The `GetLongPathNameW` query behind [`expand_to_long_path`], or `None` when it has no answer.
+#[cfg(windows)]
+fn expand_to_long_path_win32(path: &Path) -> Option<PathBuf> {
+    use std::os::windows::ffi::{OsStrExt, OsStringExt};
+    use windows_sys::Win32::Storage::FileSystem::GetLongPathNameW;
+
+    // The input is wide and NUL-terminated because the API takes no length for it. `encode_wide` never
+    // yields a NUL, so the one pushed here is the only terminator.
+    let mut source: Vec<u16> = path.as_os_str().encode_wide().collect();
+    source.push(0);
+
+    // The sizing call answers the length it needs *including* the terminator, and zero when it cannot
+    // resolve the path at all.
+    let needed = unsafe { GetLongPathNameW(source.as_ptr(), std::ptr::null_mut(), 0) };
+    if needed == 0 {
+        return None;
+    }
+
+    // The filling call answers the length it wrote *excluding* the terminator. A rename between the two
+    // calls makes it answer a size larger than the buffer, and that is the one case to refuse rather
+    // than truncate: half a path is worse than the short spelling this returns instead.
+    let mut buffer = vec![0u16; needed as usize];
+    let written = unsafe { GetLongPathNameW(source.as_ptr(), buffer.as_mut_ptr(), needed) };
+    if written == 0 || written > needed {
+        return None;
+    }
+    buffer.truncate(written as usize);
+    Some(PathBuf::from(std::ffi::OsString::from_wide(&buffer)))
+}
