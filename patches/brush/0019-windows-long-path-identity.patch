+/// Expands a well-known directory variable into its long form, so one directory has one spelling.
+///
+/// `%TEMP%` is what `/tmp` resolves to, and Windows reports the short (8.3) spelling when the profile
+/// directory has one (`C:\Users\EXAMPL~1\AppData\Local\Temp`), while a script that names the same
+/// directory in full produces the long one. Two spellings of one place is what makes a comparison
+/// between `$TEMP` and a written-out path false.
+///
+/// Only the three temporary-directory names are touched, because those are the ones the engine itself
+/// resolves paths against. `PATH` and the rest keep exactly the value the host set: rewriting them would
+/// change what a script reads back, and none of them is compared against an engine-produced path.
+///
+/// A value that is not an absolute path is left alone — a relative `TMPDIR` has no long form to take,
+/// and `expand_to_long_path` would resolve it against the current directory.
+fn expand_well_known_path(name: &str, value: String) -> String {
+    if !matches!(name, "TEMP" | "TMP" | "TMPDIR") {
+        return value;
+    }
+    let path = std::path::Path::new(&value);
+    if !path.is_absolute() {
+        return value;
+    }
+    match crate::sys::fs::expand_to_long_path(path).into_os_string().into_string() {
+        Ok(expanded) => expanded,
+        // An expansion that is not valid Unicode cannot replace a value that is: keeping the original
+        // leaves the shell with the spelling it had rather than with a lossy one.
+        Err(_) => value,
+    }
+}
