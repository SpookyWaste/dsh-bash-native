+/// Dispatches to the command this process is named after, if it is registered.
+///
+/// The lookup is the gate, not the name's shape: anything not in the registry
+/// (including `brush`, `bash` and `sh`) starts a shell. The bundled name, not
+/// the executable's path, becomes `argv[0]`, so the utility reports itself as
+/// `rm` rather than as a path.
+fn dispatch_by_name(argv0: Option<&OsStr>, args: Vec<OsString>) -> Option<i32> {
+    let name = Path::new(argv0?).file_stem()?.to_str()?.to_owned();
+    let func = *REGISTRY.get()?.get(name.as_str())?;
+
+    let mut argv: Vec<OsString> = Vec::with_capacity(1 + args.len());
+    argv.push(OsString::from(name));
+    // No shell translated these arguments: in this path the utility *is* the process, and it reads them as
+    // paths. The rules are the shell's own (patch `0004`), including its environment switch, so
+    // `xargs rm /tmp/x` means what `rm /tmp/x` means typed at the prompt. The explicit dispatch flag needs
+    // none of this, because the shell that spawned it translated the arguments already.
+    let convert = !path_conversion_disabled();
+    argv.extend(
+        args.into_iter()
+            .map(|arg| if convert { brush_core::sys::fs::normalize_shell_arg(&arg) } else { arg }),
+    );
+
+    Some(func(argv))
+}
+
+/// Whether the environment switch turns the `/tmp` argument rewrite off.
+///
+/// Patch `0004` owns the rule: the switch disables the rewrite when it is set and is neither empty nor `0`,
+/// the way `MSYS_NO_PATHCONV` behaves in Git Bash.
+fn path_conversion_disabled() -> bool {
+    std::env::var_os("DSH_BASH_NATIVE_NO_PATHCONV")
+        .is_some_and(|value| !value.is_empty() && value.to_string_lossy() != "0")
+}
