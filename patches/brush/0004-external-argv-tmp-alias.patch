+/// Whether the script asked for verbatim arguments.
+///
+/// Both spellings work: an exported variable, and a per-command assignment
+/// (`DSH_BASH_NATIVE_NO_PATHCONV=1 some-tool /tmp/x`), which the shell keeps set for the duration of
+/// that command. The value disables the rewrite when it is set and is neither empty nor `0`, the way
+/// `MSYS_NO_PATHCONV` behaves in Git Bash.
+fn path_conversion_disabled<SE: extensions::ShellExtensions>(context: &ExecutionContext<'_, SE>) -> bool {
+    const NAME: &str = "DSH_BASH_NATIVE_NO_PATHCONV";
+    if let Some((_, var)) = context.shell.env().get(NAME) {
+        let value = var.value().to_cow_str(context.shell);
+        if !value.is_empty() && value.as_ref() != "0" {
+            return true;
+        }
+    }
+    std::env::var_os(NAME).is_some_and(|value| !value.is_empty() && value.to_string_lossy() != "0")
+}
