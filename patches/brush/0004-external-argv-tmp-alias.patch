+/// Rewrites one argument a script hands to an external program.
+///
+/// The shell's own path resolution covers what the shell opens (redirections, `cd`, `test`, globs),
+/// but arguments reach the child verbatim, so a bundled utility, a toolchain program and any foreign
+/// program all see a literal `/tmp/...`, which Windows resolves against the current drive's root
+/// (`<drive>:\tmp`) rather than the temporary directory. Translating here — at the one boundary
+/// every external spawn passes through, including the shim that re-enters this binary for the
+/// bundled utilities — keeps the shell, the bundled tools and foreign programs agreeing.
+///
+/// Two forms are rewritten, both measured against Git Bash's behaviour: a bare `/tmp`-rooted
+/// operand, and an option's attached value (`--file=/tmp/x`). Everything else is returned unchanged:
+/// this engine has no `/c/...` mount, so `/dev/...` and `/etc/...` keep their existing meaning, and
+/// an argument that merely *contains* the alias — a search pattern or a commit message — is never
+/// rewritten. Set `DSH_BASH_NATIVE_NO_PATHCONV` to disable the rewrite entirely.
+#[must_use]
+pub fn normalize_shell_arg(arg: &std::ffi::OsStr) -> std::ffi::OsString {
+    #[cfg(windows)]
+    if let Some(converted) = translate_tmp_argument(arg, &std::env::temp_dir) {
+        return converted;
+    }
+    arg.to_os_string()
+}
+
+/// `Some(path)` when the argument names a `/tmp`-rooted path, in either supported form.
+#[cfg(any(windows, test))]
+fn translate_tmp_argument(arg: &OsStr, temp_dir: &impl Fn() -> PathBuf) -> Option<std::ffi::OsString> {
+    if let Some(path) = translate_unix_tmp_path(Path::new(arg), temp_dir) {
+        return Some(path.into_os_string());
+    }
+    let (option, value) = arg.to_str()?.split_once('=')?;
+    if !option.starts_with('-') {
+        return None;
+    }
+    let path = translate_unix_tmp_path(Path::new(value), temp_dir)?;
+    let mut converted = std::ffi::OsString::from(option);
+    converted.push("=");
+    converted.push(path);
+    Some(converted)
+}
