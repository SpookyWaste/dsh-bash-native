+#[cfg(test)]
+mod normalize_shell_arg_tests {
+    use super::translate_tmp_argument;
+    use std::ffi::{OsStr, OsString};
+    use std::path::PathBuf;
+
+    fn temp() -> PathBuf {
+        PathBuf::from(r"C:\Users\Adam\AppData\Local\Temp")
+    }
+
+    fn rewrite(arg: &str) -> Option<OsString> {
+        translate_tmp_argument(OsStr::new(arg), &temp)
+    }
+
+    #[test]
+    fn bare_tmp_arguments_are_rewritten() {
+        assert_eq!(rewrite("/tmp"), Some(temp().into_os_string()));
+        assert_eq!(
+            rewrite("/tmp/probe/sub"),
+            Some(temp().join("probe").join("sub").into_os_string())
+        );
+    }
+
+    #[test]
+    fn attached_option_values_are_rewritten() {
+        let mut expected = OsString::from("--file=");
+        expected.push(temp().join("probe"));
+        assert_eq!(rewrite("--file=/tmp/probe"), Some(expected));
+    }
+
+    #[test]
+    fn data_arguments_are_left_alone() {
+        // A pattern or a message that merely contains the alias keeps its meaning, and a bare
+        // `name=value` is data rather than an option's attached value.
+        assert_eq!(rewrite("commit message /tmp/x"), None);
+        assert_eq!(rewrite("a=/tmp/x"), None);
+        assert_eq!(rewrite("-x"), None);
+        assert_eq!(rewrite("/tmpfile"), None);
+        assert_eq!(rewrite("/var/tmp/x"), None);
+        assert_eq!(rewrite("/dev/null"), None);
+    }
+}
