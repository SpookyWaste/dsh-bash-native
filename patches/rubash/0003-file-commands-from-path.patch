 /// Windows-port-only emulated mode store: unix chmod writes the real inode
 /// mode instead (PermissionsExt::set_mode above).
 #[cfg_attr(unix, allow(dead_code))]
@@ -2169,3 +2227,23 @@ fn store_emulated_file_mode(env_vars: &mut VarTable, windows: &str, mode: u32) {
     kept.push(format!("{}={:o}", windows, mode));
     env_vars.insert(key.to_string(), kept.join(DATA_DOLLAR_STR));
 }
+
+#[cfg(test)]
+mod file_commands_from_path_tests {
+    use super::policy_defers_file_command;
+
+    #[test]
+    fn policy_table_selects_commands_and_base_names() {
+        assert!(!policy_defers_file_command("", "cat"));
+        assert!(!policy_defers_file_command("   ", "cat"));
+        assert!(!policy_defers_file_command("none", "cat"));
+        assert!(!policy_defers_file_command("0", "cat"));
+        assert!(!policy_defers_file_command("1", "cat"));
+        assert!(policy_defers_file_command("all", "cat"));
+        assert!(policy_defers_file_command("all", "/bin/pwd"));
+        assert!(policy_defers_file_command("sed,rmdir", "sed"));
+        assert!(policy_defers_file_command(" sed , rmdir ", "/usr/bin/sed"));
+        assert!(!policy_defers_file_command("sed,rmdir", "cat"));
+        assert!(policy_defers_file_command("SED", "sed"));
+    }
+}
