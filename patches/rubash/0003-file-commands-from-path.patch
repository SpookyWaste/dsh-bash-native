+/// The shell variable that decides which of the commands above run from `PATH`.
+const FILE_COMMANDS_FROM_PATH_VAR: &str = "RUBASH_FILE_COMMANDS_FROM_PATH";
+
+/// Whether a `RUBASH_FILE_COMMANDS_FROM_PATH` value leaves `word` to `PATH`.
+///
+/// dsh-bash-native patch: `all`/`on`/`1` leaves every name to PATH, `none`/`off`/`0`/empty
+/// (the default) leaves none, and any other value is a comma- or whitespace-separated list of
+/// command names. A name matches the word itself or its base name, case-insensitively, so `cat`
+/// also covers `/bin/cat` and `/usr/bin/cat` — the layer intercepts all three spellings of one
+/// program, which is why the list may name any of them.
+fn policy_defers_file_command(policy: &str, word: &str) -> bool {
+    let policy = policy.trim();
+    if policy.is_empty() {
+        return false;
+    }
+    match policy.to_ascii_lowercase().as_str() {
+        "all" | "on" | "yes" | "true" | "1" => return true,
+        "none" | "off" | "no" | "false" | "0" => return false,
+        _ => {}
+    }
+    let base = word.rsplit('/').next().unwrap_or(word);
+    policy
+        .split(|ch: char| ch == ',' || ch.is_whitespace())
+        .map(str::trim)
+        .filter(|name| !name.is_empty())
+        .any(|name| name.eq_ignore_ascii_case(word) || name.eq_ignore_ascii_case(base))
+}
