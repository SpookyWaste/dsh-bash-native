+    fn data_primary_positions_hold_for_native_children() {
+        // dsh-bash-native 0001: a third-party suite is never `posix_aware`, so
+        // its operands still take the native funnel; the pattern/script/program
+        // positions are grammar properties and must stay verbatim.
+        let root = i164_fixture_root();
