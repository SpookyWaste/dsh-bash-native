diff --git a/src/chunks.rs b/src/chunks.rs
index acf6b0a..5928e4d 100644
--- a/src/chunks.rs
+++ b/src/chunks.rs
@@ -77,7 +77,11 @@ impl Iterator for ReverseChunks<'_> {
         // (that is, the chunk closest to the beginning of the file),
         // which contains the remainder of the bytes.
         let block_size = if self.block_idx == self.max_blocks_to_read - 1 {
-            self.size % BLOCK_SIZE
+            // Measured against a file whose size is a whole multiple of `BLOCK_SIZE`: the remainder is
+            // zero there, so the chunk closest to the beginning held no bytes and the lines it should
+            // have carried were missing. Subtracting what the other blocks cover gives this chunk its
+            // full `BLOCK_SIZE` in that case, and the remainder in every other.
+            self.size - (self.max_blocks_to_read as u64 - 1) * BLOCK_SIZE
         } else {
             BLOCK_SIZE
         };
