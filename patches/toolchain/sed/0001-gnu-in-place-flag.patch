+/// Rewrite the in-place option into a spelling clap cannot confuse with the script operand.
+///
+/// GNU sed accepts a suffix only when it is attached (`-i.bak`), but this utility declares the
+/// option as `num_args(0..=1)`, so clap consumes the following argument as the suffix. The ordinary
+/// `sed -i 's/a/b/' file` therefore hands the script to `-i` and parses the file name as a script.
+/// Normalizing to `--in-place[=SUFFIX]` with `require_equals` keeps the operand where it belongs.
+fn normalize_in_place_option(args: impl uucore::Args) -> Vec<std::ffi::OsString> {
+    let mut normalized = Vec::new();
+    for (index, argument) in args.into_iter().enumerate() {
+        if index > 0 {
+            let text = argument.to_string_lossy();
+            if text == "-i" || text == "--in-place" {
+                normalized.push(std::ffi::OsString::from("--in-place="));
+                continue;
+            }
+            if let Some(suffix) = text.strip_prefix("-i") {
+                if !suffix.is_empty() && !suffix.starts_with('-') {
+                    normalized.push(std::ffi::OsString::from(format!("--in-place={suffix}")));
+                    continue;
+                }
+            }
+        }
+        normalized.push(argument);
+    }
+    normalized
+}
