+/// Whether the path's last component is `.` once trailing separators are dropped.
+///
+/// `..` is deliberately not rejected: its parent necessarily contains it, so Win32 reports
+/// ERROR_DIR_NOT_EMPTY, which is what MSYS2 `rmdir x/..` returns as well.
+#[cfg(windows)]
+fn has_dot_last_component(path: &Path) -> bool {
+    let text = path.to_string_lossy();
+    let trimmed = text.trim_end_matches(['/', '\\']);
+    trimmed == "." || trimmed.ends_with("/.") || trimmed.ends_with("\\.")
+}
