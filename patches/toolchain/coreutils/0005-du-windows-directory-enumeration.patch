+/// traversal, and that entry keeps the regular traversal for its whole subtree; everything else
+/// stays on the enumeration.
+#[derive(Clone, Copy, PartialEq, Eq)]
+enum WalkMode {
+    Legacy,
+    #[cfg(windows)]
+    Fast,
+}
+
+/// Account for one directory entry: exclusion, hard-link deduplication, `--one-file-system`,
+/// then accumulate it into `my_stat` and recurse into directories.
+///
+/// `entry_name` is the entry's name inside its directory: the excludes match it as well as the
+/// full path.
+#[allow(clippy::too_many_arguments)]
+fn process_entry(
+    this_stat: Stat,
+    entry_name: &OsStr,
+    options: &TraversalOptions,
+    depth: usize,
+    seen_inodes: &mut FxHashSet<FileInfo>,
+    print_tx: &mpsc::Sender<UResult<StatPrintInfo>>,
+    ancestors: Option<&mut FxHashSet<FileInfo>>,
+    symlink_depth: usize,
+    walk_mode: WalkMode,
+    my_stat: &mut Stat,
+) -> Result<(), Box<mpsc::SendError<UResult<StatPrintInfo>>>> {
+    // We have an exclude list
+    for pattern in &options.excludes {
+        // Look at all patterns with both short and long paths
+        // if we have 'du foo' but search to exclude 'foo/bar'
+        // we need the full path
+        if pattern.matches(&this_stat.path.to_string_lossy())
+            || pattern.matches(entry_name.to_string_lossy().as_ref())
+        {
+            // if the directory is ignored, leave early
+            if options.verbose {
+                println!(
+                    "{}",
+                    translate!("du-verbose-ignored", "path" => this_stat.path.quote())
+                );
+            }
+            // Go to the next file
+            return Ok(());
+        }
+    }
+
+    if let Some(inode) = this_stat.inode {
+        // Check if the inode has been seen before and if we should skip it
+        if seen_inodes.contains(&inode) && !options.count_links {
+            // Skip further processing for this inode
+            return Ok(());
+        }
+        // Mark this inode as seen
+        seen_inodes.insert(inode);
+    }
+
+    if this_stat.is_dir {
+        if options.one_file_system
+            && let (Some(this_inode), Some(my_inode)) = (this_stat.inode, my_stat.inode)
+            && this_inode.dev_id != my_inode.dev_id
+        {
+            return Ok(());
+        }
+
+        let this_stat = du_walk(
+            walk_mode,
+            this_stat,
+            options,
+            depth + 1,
+            seen_inodes,
+            print_tx,
+            ancestors,
+            Some(symlink_depth),
+        )?;
+
+        if !options.separate_dirs {
+            my_stat.size += this_stat.size;
+            my_stat.blocks += this_stat.blocks;
+            my_stat.inodes += this_stat.inodes;
+            merge_latest_time(&mut my_stat.latest_time, this_stat.latest_time);
+        }
+        print_tx.send(Ok(StatPrintInfo {
+            stat: this_stat,
+            depth: depth + 1,
+        }))?;
+    } else {
+        my_stat.size += this_stat.size;
+        my_stat.blocks += this_stat.blocks;
+        my_stat.inodes += 1;
+        merge_latest_time(&mut my_stat.latest_time, this_stat.latest_time);
+        if options.all {
+            print_tx.send(Ok(StatPrintInfo {
+                stat: this_stat,
+                depth: depth + 1,
+            }))?;
+        }
+    }
+
+    Ok(())
+}
+
+/// Keep the newest timestamp of the subtree, which is what `--time` reports for a directory.
+fn merge_latest_time(into: &mut Option<SystemTime>, other: Option<SystemTime>) {
+    *into = match (*into, other) {
+        (Some(a), Some(b)) => Some(a.max(b)),
+        (a, None) => a,
+        (None, b) => b,
+    };
+}
+
+/// Continue the traversal with the implementation `walk_mode` names.
+#[allow(clippy::too_many_arguments)]
+fn du_walk(
+    walk_mode: WalkMode,
+    my_stat: Stat,
+    options: &TraversalOptions,
+    depth: usize,
+    seen_inodes: &mut FxHashSet<FileInfo>,
+    print_tx: &mpsc::Sender<UResult<StatPrintInfo>>,
+    ancestors: Option<&mut FxHashSet<FileInfo>>,
+    symlink_depth: Option<usize>,
+) -> Result<Stat, Box<mpsc::SendError<UResult<StatPrintInfo>>>> {
+    match walk_mode {
+        WalkMode::Legacy => du_regular(
+            my_stat,
+            options,
+            depth,
+            seen_inodes,
+            print_tx,
+            ancestors,
+            symlink_depth,
+        ),
+        #[cfg(windows)]
+        WalkMode::Fast => {
+            windows_enum::walk(my_stat, options, depth, seen_inodes, print_tx, ancestors)
+        }
+    }
+}
